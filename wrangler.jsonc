{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare panelindeki Worker adıyla aynı olmalı
  "name": "connectbilisim",
  "compatibility_date": "2026-09-28",
  // `npm run build` → out/ klasöründeki statik dosyaları sun
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
